{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "a1essandro/perlin-noise": "^1.2",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^12.0",
        "laravel/reverb": "^1.5",
        "laravel/sanctum": "^4.1",
        "laravel/tinker": "^2.9",
        "natsimhan/simplex-noise": "^1.0",
        "predis/predis": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Modules\\Common\\": "app/Modules/Common/",
            "App\\Modules\\Auth\\": "app/Modules/Auth/",
            "App\\Modules\\Campaign\\": "app/Modules/Campaign/",
            "App\\Modules\\GameEngine\\": "app/Modules/GameEngine/",
            "App\\Modules\\MapGeneration\\": "app/Modules/MapGeneration/",
            "App\\Modules\\Combat\\": "app/Modules/Combat/",
            "App\\Modules\\Chat\\": "app/Modules/Chat/",
            "App\\Modules\\Notifications\\": "app/Modules/Notifications/",
            "App\\Modules\\Analytics\\": "app/Modules/Analytics/",
            "Database\\Factories\\": "app/Modules/Common/Factories/",
            "Database\\Seeders\\": "app/Modules/Common/Seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
